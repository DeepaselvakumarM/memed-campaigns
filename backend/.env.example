# Copy to .env and fill in real values. Never commit .env.
# MongoDB Atlas connection string (must include the database name, e.g. /memed)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memed?retryWrites=true&w=majority
# Long random string used to sign JWTs (min 32 chars)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d
PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
